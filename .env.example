PORT=5000

# Upstream Passthrough API Base URL (OpusZen Gateway)
UPSTREAM_API_BASE=https://api.opuszen.shop

# Master Upstream API Key (Optional: for middle man forwarding)
UPSTREAM_API_KEY=

# Middle Man Public API Domain (The domain your users and IDEs connect to)
API_DOMAIN=https://api.opuszyra.live

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Client Vite Configuration
VITE_API_BASE_URL=http://localhost:5000
VITE_API_DOMAIN=https://api.opuszyra.live
