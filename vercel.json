{
  "version": 2,
  "installCommand": "npm install && npm --prefix client install",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|v1/|api$|v1$).*)",
      "destination": "/index.html"
    }
  ]
}
