PORT=5000

# Upstream Passthrough API Base URL (OpusZen Gateway)
UPSTREAM_API_BASE=https://api.opuszen.shop

# Master Upstream API Key (Optional: for middle man forwarding)
UPSTREAM_API_KEY=

# Middle Man Public API Domain (The domain your users and IDEs connect to)
API_DOMAIN=https://api.opuszyra.live

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Direct Postgres Connection
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DB_HOST=db.[PROJECT_REF].supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_db_password
