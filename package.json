{
  "name": "opuszenvix",
  "version": "1.0.0",
  "description": "Opuszenvix - Anthropic-Compatible AI Proxy & API Gateway with React, Tailwind CSS, Node.js, and Supabase",
  "private": true,
  "type": "module",
  "bin": {
    "opuszenvix": "./bin/cli.js",
    "opuszyra": "./bin/cli.js"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/server.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "npm --prefix client run dev",
    "server:dev": "npm --prefix server run dev",
    "client:build": "npm --prefix client run build",
    "server:start": "npm --prefix server start",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
